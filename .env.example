# ==============================================================================
# Pokémon Battle Simulator - Production Environment Variables
# Target Host: AWS EC2 t3a.micro (Ubuntu 24.04, linux/amd64, 1 GiB RAM)
# ==============================================================================

# Your domain name. Caddy uses this to automatically obtain and renew Let's Encrypt certificates.
# Example: DOMAIN=battle.myportfolio.com (or localhost for local testing)
DOMAIN=battle.example.com

# GitHub Container Registry (GHCR) repository owner (lowercase GitHub username or organization)
GHCR_OWNER=your-github-username

# Explicit commit SHA tags to deploy (pins exact immutable images; never use 'latest' in production)
# Example: SERVER_IMAGE_TAG=e89a557b447814c99738dafe5bc62886f4c8e788
SERVER_IMAGE_TAG=commit_sha_here
WEB_IMAGE_TAG=commit_sha_here

# Optional CORS Origin (only required if client is served from a separate host, e.g. staging)
# Leave blank for default same-origin deployment through Caddy
CORS_ORIGIN=

# NOTE ON CLIENT BUILD-TIME CONFIGURATION (Vite):
# Client settings (VITE_SERVER_URL, sprite CDN templates) are embedded into the client
# bundle at Docker build-time via GitHub Actions repository variables. They are not read at runtime.
# See docs/DEPLOY.md for full details.
